flowchart LR
    U[Participante humano]
    X[Agente ou sistema externo]

    subgraph K[Kaelle]
        WEB[Aplicação Web<br/>UI + server functions]
        DATA[(PostgreSQL<br/>Auth + Realtime + RLS)]
        WORKER[Worker Python<br/>LiveKit Agent]
        INTEROP[Interfaces MCP / A2A]
    end

    LK[LiveKit Cloud<br/>salas + SFU]
    OAI[OpenAI<br/>STT + LLM]
    ELEVEN[ElevenLabs<br/>TTS]
    TAVUS[Tavus<br/>avatar opcional]

    U --> WEB
    WEB --> DATA
    WEB --> LK
    WEB -->|dispatch explícito| LK
    LK <--> WORKER
    WORKER --> OAI
    WORKER --> ELEVEN
    WORKER -. opcional .-> TAVUS
    WORKER -->|transcrição / contexto| WEB
    X <--> INTEROP
    INTEROP <--> WEB

    %% O protocolo social e a governança são responsabilidades de domínio
    %% distribuídas principalmente entre a aplicação e o SocialAgent.
